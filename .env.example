# Server-only. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_CREDENTIALS_KEY=

# Provisioned by Neon/Vercel.
DATABASE_URL=

# Transactional account emails (Resend). Keep the API key server-side.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Hybrid Athlete <onboarding@resend.dev>
AUTH_PUBLIC_URL=https://garmin-connect-six.vercel.app

# AI assistant. AI_GATEWAY_API_KEY is optional on Vercel when OIDC is enabled.
AI_GATEWAY_API_KEY=
HYBRID_AI_MODEL=anthropic/claude-sonnet-5
# Hard ceiling per answer; 256-1200 tokens.
HYBRID_AI_MAX_OUTPUT_TOKENS=700

# Optional per-user daily AI token budget. Missing/invalid values use 50000.
# Resets at midnight Europe/Budapest. A token is a small unit of processed text.
HYBRID_AI_DAILY_TOKEN_LIMIT=50000
# Optional estimates in USD per 1 million tokens; set BOTH from the chosen model's rates.
# Leave empty to disable monetary estimates. These are NOT dollar spending caps.
HYBRID_AI_INPUT_USD_PER_MILLION=
HYBRID_AI_OUTPUT_USD_PER_MILLION=
