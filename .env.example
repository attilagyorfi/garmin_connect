# Server-only. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_CREDENTIALS_KEY=

# Provisioned by Neon/Vercel.
DATABASE_URL=

# Comma-separated admin e-mails. Listed addresses may register without an invite and get the admin role.
HYBRID_ADMIN_EMAILS=

# Claude API for the Edzőtárs assistant.
ANTHROPIC_API_KEY=
# Service-wide monthly AI budget in USD (default 25): admins are e-mailed at 80%, the assistant pauses at 100%.
AI_MONTHLY_BUDGET_USD=

# Vercel Cron bearer secret for the protected daily model-maintenance endpoint (/api/retrain).
CRON_SECRET=

# Transactional e-mail (password reset, invites) via Resend. The sender must be on a domain verified in Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Public app URL used in e-mailed links (defaults to the Vercel production domain).
AUTH_PUBLIC_URL=
# Local development only: 1 = do not send any e-mail. Leave unset in production.
AUTH_EMAIL_TEST_MODE=
